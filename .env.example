# Environment configuration for Team Logo Combiner
# Copy this file to .env and adjust values as needed

# =============================================================================
# FLASK CONFIGURATION
# =============================================================================
FLASK_ENV=production
FLASK_HOST=0.0.0.0
FLASK_PORT=5002
FLASK_DEBUG=false
LOG_LEVEL=INFO

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================

# Redis connection URL
REDIS_URL=redis://fogis-redis:6379

# Enable/disable Redis pub/sub integration
REDIS_PUBSUB_ENABLED=true

# Redis channel configuration
REDIS_AVATAR_REQUESTS_CHANNEL=fogis:avatars:requests
REDIS_AVATAR_RESULTS_CHANNEL=fogis:avatars:results
REDIS_SERVICE_STATUS_CHANNEL=fogis:avatars:status

# =============================================================================
# PROCESSING CONFIGURATION
# =============================================================================

# Avatar result storage method: 'base64', 'google_drive', or 'url'
AVATAR_RESULT_STORAGE=base64

# Avatar processing timeout in seconds
AVATAR_PROCESSING_TIMEOUT=30

# =============================================================================
# COMMUNICATION MODE
# =============================================================================

# Communication mode: 'http', 'redis', or 'dual'
# - http: Only HTTP endpoints (legacy mode)
# - redis: Only Redis pub/sub (new mode)
# - dual: Both HTTP and Redis (transition mode, default)
COMMUNICATION_MODE=dual

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Enable console logging
LOG_ENABLE_CONSOLE=true

# Enable file logging
LOG_ENABLE_FILE=true

# Enable structured logging
LOG_ENABLE_STRUCTURED=true

# Log directory
LOG_DIR=logs

# Log file name
LOG_FILE=team-logo-combiner.log

